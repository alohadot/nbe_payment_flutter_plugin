<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.example.nbe_payment_flutter_plugin">

    <!-- The Gateway SDK manifests do not declare it, and Flutter templates only add it to
         debug/profile builds, so release apps would fail to reach the gateway without it. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
